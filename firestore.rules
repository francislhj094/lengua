rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Entitlement state is owned by the RevenueCat webhook, which writes via
      // the Admin SDK and bypasses these rules. Clients may write their own
      // profile and progress, but must never grant themselves premium.
      // Split from update because resource.data does not exist on create.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !('entitlement' in request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['entitlement']);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
